font: "/main/assets/fonts/kenvector_future.ttf"
material: "/builtins/fonts/font.material"
size: 25
characters: " !\"#$%&\'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
styles {
  name: "default"
}
styles {
  name: "link"
  markup: "<color=#1972e5><ul>"
}
styles {
  name: "link:hover"
  markup: "<color=#4ca5ff>"
}
styles {
  name: "link:active"
  markup: "<color=#0c4cb2>"
}
runtime: true
