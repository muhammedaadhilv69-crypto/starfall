function init(self)
	print("HUD INITIALIZED")
	print("GUI WIDTH:", gui.get_width())
	print("GUI HEIGHT:", gui.get_height())

	self.health = 100
	self.max_health = 100

	gui.set_text(
		gui.get_node("health_text"),
		"HEALTH: 100"
	)

	self.score = 0

	gui.set_text(
		gui.get_node("score_text"),
		"SCORE: 0"
	)

	self.high_score = 0

	gui.set_text(
		gui.get_node("high_score_text"),
		"BEST: 0"
	)

	gui.set_enabled(gui.get_node("health_bg"), false)
	gui.set_enabled(gui.get_node("health_fill"), false)
	gui.set_enabled(gui.get_node("health_text"), false)
	gui.set_enabled(gui.get_node("score_text"), false)
	gui.set_enabled(gui.get_node("high_score_text"), false)
end

function on_message(self, message_id, message, sender)
	if message_id == hash("update_health") then
		self.health = message.health

		gui.set_text(
			gui.get_node("health_text"),
			"HEALTH: " .. self.health
		)

		local health_ratio = math.max(
			0,
			self.health / self.max_health
		)

		gui.set_size(
			gui.get_node("health_fill"),
			vmath.vector3(200 * health_ratio, 18, 0)
		)

		local health_fill = gui.get_node("health_fill")

		if self.health <= 10 then
			gui.set_color(
				health_fill,
				vmath.vector4(1, 0, 0, 1)
			)
		elseif self.health <= 50 then
			gui.set_color(
				health_fill,
				vmath.vector4(1, 0.5, 0, 1)
			)
		else
			gui.set_color(
				health_fill,
				vmath.vector4(0, 1, 0, 1)
			)
		end
	elseif message_id == hash("update_score") then
		self.score = message.score

		gui.set_text(
			gui.get_node("score_text"),
			"SCORE: " .. self.score
		)
	elseif message_id == hash("update_high_score") then
		self.high_score = message.high_score

		gui.set_text(
			gui.get_node("high_score_text"),
			"BEST: " .. self.high_score
		)
	elseif message_id == hash("show_hud") then
		gui.set_enabled(gui.get_node("health_bg"), true)
		gui.set_enabled(gui.get_node("health_fill"), true)
		gui.set_enabled(gui.get_node("health_text"), true)
		gui.set_enabled(gui.get_node("score_text"), true)
		gui.set_enabled(gui.get_node("high_score_text"), true)

		print("HUD SHOWN")
	end
end
