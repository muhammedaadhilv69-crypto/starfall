function init(self)
	msg.post(".", "acquire_input_focus")

	self.speed = 750

	self.moving_up = false
	self.moving_down = false
	self.moving_left = false
	self.moving_right = false

	self.screen_width = 1920
	self.screen_height = 1080

	self.player_half_width = 32
	self.player_half_height = 32

	self.shoot_cooldown = 0.25
	self.shoot_timer = 0
	self.shooting = false

	self.max_health = 150
	self.health = self.max_health
	self.is_dead = false

	self.game_active = false
end

function update(self, dt)
	if not self.game_active or self.is_dead then
		return
	end

	local direction = vmath.vector3(0, 0, 0)

	if self.moving_up then
		direction.y = direction.y + 1
	end

	if self.moving_down then
		direction.y = direction.y - 1
	end

	if self.moving_left then
		direction.x = direction.x - 1
	end

	if self.moving_right then
		direction.x = direction.x + 1
	end

	-- Prevent diagonal movement from being faster
	if vmath.length(direction) > 0 then
		direction = vmath.normalize(direction)
	end

	-- Calculate movement
	local position = go.get_position()
	position = position + direction * self.speed * dt

	-- Keep the player inside the screen
	position.x = math.max(
		self.player_half_width,
		math.min(position.x, self.screen_width - self.player_half_width)
	)

	position.y = math.max(
		self.player_half_height,
		math.min(position.y, self.screen_height - self.player_half_height)
	)

	-- Shooting cooldown
	if self.shoot_timer > 0 then
		self.shoot_timer = self.shoot_timer - dt
	end

	-- Shoot when the timer reaches zero
	if self.shooting and self.shoot_timer <= 0 then
		local player_position = go.get_position()

		local spawn_position = player_position +
			vmath.vector3(0, 45, 0)

		factory.create(
			"#laser_factory",
			spawn_position,
			nil
		)

		self.shoot_timer = self.shoot_cooldown
	end

	go.set_position(position)
end

function on_input(self, action_id, action)
	if self.is_dead then
		return
	end
	if action_id == hash("up") then
		self.moving_up = action.pressed or (self.moving_up and not action.released)
	elseif action_id == hash("down") then
		self.moving_down = action.pressed or (self.moving_down and not action.released)
	elseif action_id == hash("left") then
		self.moving_left = action.pressed or (self.moving_left and not action.released)
	elseif action_id == hash("right") then
		self.moving_right = action.pressed or (self.moving_right and not action.released)
	elseif action_id == hash("fire") then
		self.shooting = action.pressed or
			(self.shooting and not action.released)
	end
end

local function take_damage(self, amount)
	if self.is_dead then
		return
	end

	self.health = math.max(0, self.health - amount)

	print("PLAYER HEALTH:", self.health)

	if self.health <= 0 then
		self.health = 0
		self.is_dead = true
		print("GAME OVER")
		msg.post("/game_manager#game_manager", "game_over")
	end

	msg.post("/hud#hud", "update_health", {
		health = self.health
	})
end

local function reset_player(self)
	self.health = self.max_health
	self.is_dead = false
	self.game_active = false

	go.set_position(vmath.vector3(960, 150, 1))

	self.moving_up = false
	self.moving_down = false
	self.moving_left = false
	self.moving_right = false
	self.shooting = false

	self.shoot_timer = 0

	msg.post("/hud#hud", "update_health", {
		health = self.health
	})

	print("PLAYER RESET")
end

function on_message(self, message_id, message, sender)
	if message_id == hash("trigger_response") then
		if message.other_group == hash("enemies") and message.enter then
			take_damage(self, math.ceil(math.random(10, 20)))
		elseif message.other_group == hash("enemy_bullets") and message.enter then
			take_damage(self, math.ceil(math.random(5, 15)))
		end
	elseif message_id == hash("start_game") then
		self.game_active = true
		print("PLAYER ENABLED")
	elseif message_id == hash("game_over") then
		self.game_active = false
		print("PLAYER DISABLED")
	elseif message_id == hash("reset_player") then
		reset_player(self)
	end
end
